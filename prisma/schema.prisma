generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  passwordHash String?
  avatarUrl    String?
  provider     String        @default("EMAIL")
  googleId     String?       @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  habits       Habit[]
  habitLogs    HabitLog[]
  goals        Goal[]
  subHabits    SubHabit[]
  subHabitLogs SubHabitLog[]
}

model Habit {
  id              String     @id @default(cuid())
  userId          String
  title           String
  category        String     @default("Lifestyle")
  cadence         String     @default("DAILY")
  targetPerPeriod Int        @default(1)
  color           String     @default("#111827")
  icon            String     @default("sparkles")
  archived        Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs            HabitLog[]
  subHabits       SubHabit[]

  @@index([userId])
}

model SubHabit {
  id        String        @id @default(cuid())
  userId    String
  habitId   String
  title     String
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit     Habit         @relation(fields: [habitId], references: [id], onDelete: Cascade)
  logs      SubHabitLog[]

  @@index([userId, habitId])
}

model SubHabitLog {
  id         String   @id @default(cuid())
  userId     String
  subHabitId String
  date       String
  value      Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subHabit   SubHabit @relation(fields: [subHabitId], references: [id], onDelete: Cascade)

  @@unique([userId, subHabitId, date])
  @@index([userId, date])
}

model HabitLog {
  id        String   @id @default(cuid())
  userId    String
  habitId   String
  date      String
  value     Int      @default(1)
  note      String?
  mood      Int?
  energy    Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([userId, habitId, date])
  @@index([userId, date])
}

model Goal {
  id           String   @id @default(cuid())
  userId       String
  title        String
  horizon      String
  targetValue  Int
  currentValue Int      @default(0)
  unit         String   @default("times")
  dueDate      String?
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, horizon])
}
